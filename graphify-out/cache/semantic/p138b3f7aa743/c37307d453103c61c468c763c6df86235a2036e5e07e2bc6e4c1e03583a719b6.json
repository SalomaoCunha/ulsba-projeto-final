s_decision", "label": "Decision: PostgreSQL + PostGIS over MySQL/SQL Server", "file_type": "concept", "source_file": "docs/arquitetura.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "PostGIS is the most mature open-source geospatial extension (ST_Distance, ST_DWithin, GiST spatial indexes); georeferencing utentes and computing distances is central to the project; the postgis/postgis Docker image is ready-made; SQL Server implies licensing and a heavier image, MySQL has more limited spatial functions."}, {"id": "docs_arquitetura_request_flow", "label": "Request Flow: Login + GET /utentes Sequence", "file_type": "concept", "source_file": "docs/arquitetura.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_arquitetura_three_tier", "label": "Three-Layer Client-Server Architecture", "file_type": "concept", "source_file": "docs/arquitetura.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_arquitetura_jwt_auth", "label": "JWT Authentication with Short Expiration", "file_type": "concept", "source_file": "docs/arquitetura.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_arquitetura_security", "label": "Security & Access Profiles Section", "file_type": "concept", "source_file": "docs/arquitetura.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "docs_arquitetura_overview", "target": "docs_arquitetura_three_tier", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/arquitetura.md", "source_location": null, "weight": 1.0}, {"source": "docs_arquitetura_three_tier", "target": "docs_arquitetura_request_flow", "relation": "references", "confidence": "EXTRACTED", "confiden